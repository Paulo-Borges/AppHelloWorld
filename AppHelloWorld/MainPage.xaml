<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppHelloWorld.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cadastro">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="240" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>

                <StackLayout
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <Image
                        HeightRequest="150"
                        HorizontalOptions="Center"
                        Source="dotnet_bot1.png"
                        VerticalOptions="Center" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="Faça o seu Contato AGORA mesmo!"
                        VerticalOptions="Center" />
                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        WidthRequest="300">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    FontSize="16"
                                    Text="Junte-se ao time do "
                                    TextColor="Black" />
                                <Span
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Borges Dev "
                                    TextColor="Black" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </StackLayout>
                <StackLayout
                    Grid.Row="1"
                    HorizontalOptions="Center"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout Margin="0,10,0,0" WidthRequest="320">
                        <Label Text="NomeCompleto" />
                        <Entry Keyboard="Text" Placeholder="Nome Completo" />
                    </StackLayout>
                    <StackLayout Margin="0,10,0,0" WidthRequest="320">
                        <Label Text="Data de Nascimento" />
                        <DatePicker Format="dd/mm/yyyy" />
                    </StackLayout>
                    <StackLayout Margin="0,10,0,0" WidthRequest="320">
                        <Label Text="Genero" />
                        <Picker Title="Selecione um gênero">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Masculino</x:String>
                                    <x:String>Femenino</x:String>
                                    <x:String>Prefiro não declarar</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                    </StackLayout>
                    <StackLayout Margin="0,10,0,0" WidthRequest="320">
                        <Label Text="Idade" />
                        <Entry Keyboard="Text" Placeholder="Idade" />
                    </StackLayout>
                </StackLayout>

                <StackLayout Grid.Row="2" WidthRequest="300">
                    <Button Text="Cadastrar" />
                </StackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
